#!/usr/bin/env bash
# On push to main:
# 1) Optionally publish locally to Cloudflare Pages
# 2) Mirror main to GitHub so Actions can rebuild the public site
set -euo pipefail

if [[ "${SKIP_CLOUDFLARE_DEPLOY:-}" == "1" && "${SKIP_GITHUB_MIRROR:-}" == "1" ]]; then
  exit 0
fi

# Back-compat aliases from the Netlify era
if [[ "${SKIP_NETLIFY_DEPLOY:-}" == "1" ]]; then
  SKIP_CLOUDFLARE_DEPLOY=1
fi

zero="0000000000000000000000000000000000000000"
should_run=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue
  if [[ "$remote_ref" == "refs/heads/main" || "$local_ref" == "refs/heads/main" ]]; then
    should_run=1
  fi
done

if [[ "$should_run" -ne 1 ]]; then
  exit 0
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [[ "${SKIP_CLOUDFLARE_DEPLOY:-}" != "1" ]]; then
  if [[ -f "$ROOT/secrets/deploy.local" ]] && grep -q '^CLOUDFLARE_API_TOKEN=.\+' "$ROOT/secrets/deploy.local"; then
    echo "pre-push: deploying wiki to Cloudflare Pages…"
    bash "$ROOT/scripts/deploy-cloudflare.sh"
  else
    echo "pre-push: no CLOUDFLARE_API_TOKEN yet; skipping local Cloudflare deploy"
  fi
else
  echo "pre-push: skipping local Cloudflare deploy (SKIP_CLOUDFLARE_DEPLOY=1)"
fi

# Mirror to GitHub so GitHub Actions continuous deploy can run.
if [[ "${SKIP_GITHUB_MIRROR:-}" != "1" ]] && git remote get-url github >/dev/null 2>&1; then
  echo "pre-push: mirroring main to GitHub…"
  SKIP_CLOUDFLARE_DEPLOY=1 SKIP_NETLIFY_DEPLOY=1 SKIP_GITHUB_MIRROR=1 \
    git push github "HEAD:refs/heads/main"
fi
